class RealtimeEngine:
    """
    Core VORTEX real-time orchestration layer.

    The existing voice/TTS system remains responsible for
    speech generation and playback.

    AgentRuntime is responsible for reasoning and controlled
    tool execution.

    Memory is accessed through the controlled search_memory
    tool when relevant instead of automatically injecting
    retrieved memory into every request.
    """

    def __init__(self) -> None:
        self.events = EventBus()

        self.memory = VortexMemory()

        self.llm = LLMEngine()

        self.tools = ToolRegistry(
            memory=self.memory
        )

        self.agent = AgentRuntime(
            llm=self.llm,
            tools=self.tools,
        )

        self.tts = TTSEngine()

        self.history: list[dict[str, str]] = []

        self._turn_id = 0
        self._interrupt = asyncio.Event()

    async def handle_text(
        self,
        text: str,
    ) -> str:
        """
        Handle one finalized user utterance.

        The agent performs reasoning/tool execution first.
        The resulting final answer is then passed into the
        existing TTS pipeline.

        TTS itself is not modified here.

        Memory is deliberately NOT preloaded into the prompt.
        The agent can call search_memory when the request
        actually requires historical or stored information.
        """

        text = text.strip()

        if not text:
            return ""

        self._turn_id += 1
        turn_id = self._turn_id

        # New user turn invalidates previous queued speech.
        self.tts.interrupt()
        self._interrupt.clear()

        await self.events.publish(
            "assistant.thinking",
            turn_id=turn_id,
        )

        # ----------------------------------------------------
        # MESSAGE CONSTRUCTION
        # ----------------------------------------------------
        #
        # Do NOT automatically inject memory.build_context()
        # into every request.
        #
        # Historical memory can contain unrelated conversation,
        # fictional stories, old timestamps, or other contextual
        # material that can interfere with live tool selection.
        #
        # The controlled search_memory tool remains available to
        # AgentRuntime and should be used when memory is actually
        # relevant to the user's request.
        # ----------------------------------------------------

        messages: list[dict[str, str]] = [
            {
                "role": "system",
                "content": SYSTEM_PROMPT,
            }
        ]

        messages.extend(
            [
                *self.history[-10:],
                {
                    "role": "user",
                    "content": text,
                },
            ]
        )

        # ----------------------------------------------------
        # AGENTIC REASONING
        # ----------------------------------------------------
        try:
            response = await self.agent.run(
                messages
            )

        except Exception as exc:
            await self.events.publish(
                "assistant.error",
                error=str(exc),
                turn_id=turn_id,
            )

            return ""

        if self._interrupt.is_set():
            return ""

        response = response.strip()

        if not response:
            await self.events.publish(
                "assistant.completed",
                response="",
                turn_id=turn_id,
            )

            return ""

        # ----------------------------------------------------
        # CONVERSATION HISTORY
        # ----------------------------------------------------
        self.history.append(
            {
                "role": "user",
                "content": text,
            }
        )

        self.history.append(
            {
                "role": "assistant",
                "content": response,
            }
        )

        # Prevent unlimited local history growth.
        if len(self.history) > 20:
            self.history = self.history[-20:]

        # ----------------------------------------------------
        # PERSIST CONVERSATION TO OBSIDIAN
        # ----------------------------------------------------
        await asyncio.to_thread(
            self.memory.save_conversation,
            text,
            response,
        )

        # ----------------------------------------------------
        # SPEECH
        # ----------------------------------------------------
        phrases = self._split_for_speech(
            response
        )

        for phrase in phrases[
            :MAX_PHRASES_PER_TURN
        ]:
            if self._interrupt.is_set():
                break

            asyncio.create_task(
                self._speak(
                    phrase,
                    turn_id,
                )
            )

        await self.events.publish(
            "assistant.completed",
            response=response,
            turn_id=turn_id,
        )

        return response

    async def _speak(
        self,
        text: str,
        turn_id: int,
    ) -> None:

        # ----------------------------------------------------
        # STALE TURN GUARD #1
        # ----------------------------------------------------
        if turn_id != self._turn_id:
            return

        if not text or not re.search(
            r"[A-Za-z0-9]",
            text,
        ):
            return

        if self._interrupt.is_set():
            return

        try:
            # ------------------------------------------------
            # STALE TURN GUARD #2
            # ------------------------------------------------
            if turn_id != self._turn_id:
                return

            await self.events.publish(
                "tts.started",
                text=text,
                turn_id=turn_id,
            )

            completed = await self.tts.speak(
                text
            )

            if not completed:
                return

            # ------------------------------------------------
            # STALE TURN GUARD #3
            # ------------------------------------------------
            if turn_id != self._turn_id:
                return

            await self.events.publish(
                "tts.completed",
                text=text,
                turn_id=turn_id,
            )

        except Exception as exc:
            await self.events.publish(
                "tts.error",
                error=str(exc),
                turn_id=turn_id,
            )

    def interrupt(
        self,
        notify: bool = True,
    ) -> None:
        self._interrupt.set()

        # Existing TTS interruption mechanism remains untouched.
        self.tts.interrupt()

        if not notify:
            return

        try:
            loop = asyncio.get_running_loop()

            loop.create_task(
                self.events.publish(
                    "assistant.interrupted"
                )
            )

        except RuntimeError:
            pass

    @staticmethod
    def _split_for_speech(
        text: str,
    ) -> list[str]:
        """
        Split a completed agent response into short speech
        phrases without changing the response itself.
        """

        phrases: list[str] = []

        buffer = text.strip()

        while buffer:
            match = re.search(
                r"(.+?[.!?])(?:\s+|$)",
                buffer,
                flags=re.DOTALL,
            )

            if not match:
                break

            phrase = match.group(1).strip()

            if phrase:
                phrases.append(phrase)

            buffer = buffer[match.end():].strip()

        if buffer:
            phrases.append(buffer)

        return phrases

    async def close(self) -> None:
        self.tts.close()