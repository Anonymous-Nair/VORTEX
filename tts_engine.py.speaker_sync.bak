from __future__ import annotations

import asyncio
import queue
import re
import threading
import time

import pyaudio
import requests


TTS_URL = "http://127.0.0.1:8892/tts"

SAMPLE_RATE = 24000
CHANNELS = 1
BYTES_PER_SAMPLE = 2

# 24 kHz * 2 bytes = 48,000 bytes/sec
# 300 ms ~= 14,400 bytes
PREBUFFER_BYTES = 48000

NETWORK_CHUNK = 16384
PLAYBACK_CHUNK = 8192


def sanitize_tts_text(text: str) -> str:
    """
    Clean LLM output before sending it to the TTS service.

    Removes:
    - emoji-only decoration
    - common markdown markers
    - control characters

    Keeps normal speech punctuation.
    """

    if not text:
        return ""

    # Markdown decoration.
    text = re.sub(r"[`*_~]+", "", text)

    # Common emoji / symbol Unicode ranges.
    text = re.sub(
        r"[\U0001F000-\U0001FAFF"
        r"\U00002700-\U000027BF"
        r"\U00002600-\U000026FF]",
        "",
        text,
    )

    # Remove control characters except whitespace.
    text = "".join(
        ch
        for ch in text
        if ch in "\n\t" or ord(ch) >= 32
    )

    # Normalize whitespace.
    text = re.sub(r"\s+", " ", text).strip()

    return text


class SpeechJob:
    def __init__(
        self,
        text: str,
        generation_id: int,
    ):
        self.text = text
        self.generation_id = generation_id
        self.done = threading.Event()


class TTSEngine:
    """
    Low-jitter streaming TTS playback.

    Guarantees:
    - 24 kHz PCM output
    - one worker
    - one active TTS request at a time
    - network reader separated from playback
    - generation-based interruption
    - text sanitized before synthesis
    """

    def __init__(self) -> None:

        self.audio = pyaudio.PyAudio()

        self.output = self.audio.open(
            format=pyaudio.paInt16,
            channels=CHANNELS,
            rate=SAMPLE_RATE,
            output=True,
            frames_per_buffer=2048,
        )

        self.jobs: queue.Queue[SpeechJob | None] = queue.Queue()

        self.running = True
        self.generation_id = 0

        self.worker = threading.Thread(
            target=self._worker,
            name="VortexTTSWorker",
            daemon=True,
        )

        self.worker.start()

    async def speak(
        self,
        text: str,
        generation_id: int | None = None,
    ) -> bool:

        text = sanitize_tts_text(text)

        if not text:
            return False

        if generation_id is None:
            generation_id = self.generation_id

        job = SpeechJob(
            text,
            generation_id,
        )

        self.jobs.put(job)

        await asyncio.to_thread(
            job.done.wait
        )

        return (
            generation_id
            == self.generation_id
        )

    def _worker(self) -> None:

        while self.running:

            job = self.jobs.get()

            if job is None:
                break

            try:

                if (
                    job.generation_id
                    == self.generation_id
                ):
                    self._run_job(job)

            except Exception as exc:

                print(
                    "[TTS ERROR] "
                    f"{type(exc).__name__}: {exc}"
                )

            finally:

                job.done.set()
                self.jobs.task_done()

    def _run_job(
        self,
        job: SpeechJob,
    ) -> None:

        started = time.perf_counter()

        print(
            f"[TTS START] {job.text}"
        )

        try:

            response = requests.post(
                TTS_URL,
                json={
                    "text": job.text,
                    "language": "English",
                },
                timeout=120,
                stream=True,
            )

            try:
                response.raise_for_status()
            except requests.RequestException as exc:
                print(
                    "[TTS HTTP ERROR] "
                    f"{type(exc).__name__}: {exc}"
                )
                response.close()
                return

            pcm_queue: queue.Queue[
                bytes | None
            ] = queue.Queue()

            reader_done = threading.Event()

            first_audio_time = None

            def reader() -> None:

                try:

                    for chunk in response.iter_content(
                        chunk_size=NETWORK_CHUNK
                    ):

                        if not chunk:
                            continue

                        if (
                            job.generation_id
                            != self.generation_id
                        ):
                            break

                        # Keep complete 16-bit samples.
                        if len(chunk) % 2:
                            chunk = chunk[:-1]

                        if chunk:
                            pcm_queue.put(chunk)

                except Exception as exc:

                    print(
                        "[TTS STREAM ERROR] "
                        f"{type(exc).__name__}: {exc}"
                    )

                finally:

                    reader_done.set()
                    pcm_queue.put(None)

            reader_thread = threading.Thread(
                target=reader,
                name="VortexTTSReader",
                daemon=True,
            )

            reader_thread.start()

            buffered = bytearray()

            try:

                # --------------------------------------------
                # PREBUFFER
                # --------------------------------------------

                while (
                    len(buffered)
                    < PREBUFFER_BYTES
                ):

                    if (
                        job.generation_id
                        != self.generation_id
                    ):
                        return

                    item = pcm_queue.get()

                    if item is None:
                        break

                    buffered.extend(item)

                if buffered:

                    first_audio_time = (
                        time.perf_counter()
                    )

                    print(
                        "[TTS FIRST AUDIO] "
                        f"{first_audio_time - started:.3f}s"
                    )

                # --------------------------------------------
                # PLAYBACK
                # --------------------------------------------

                while True:

                    if (
                        job.generation_id
                        != self.generation_id
                    ):

                        print(
                            "[TTS INTERRUPTED]"
                        )

                        break

                    if buffered:

                        usable = min(
                            len(buffered),
                            PLAYBACK_CHUNK,
                        )

                        usable -= (
                            usable % 2
                        )

                        if usable > 0:

                            chunk = bytes(
                                buffered[:usable]
                            )

                            del buffered[:usable]

                            self.output.write(
                                chunk
                            )

                            continue

                    if (
                        reader_done.is_set()
                        and pcm_queue.empty()
                    ):
                        break

                    try:

                        item = pcm_queue.get(
                            timeout=0.20
                        )

                    except queue.Empty:
                        continue

                    if item is None:
                        continue

                    buffered.extend(item)

            finally:

                response.close()

        except requests.RequestException as exc:

            print(
                "[TTS REQUEST ERROR] "
                f"{type(exc).__name__}: {exc}"
            )

        except Exception as exc:

            print(
                "[TTS ERROR] "
                f"{type(exc).__name__}: {exc}"
            )

        elapsed = (
            time.perf_counter()
            - started
        )

        print(
            "[TTS COMPLETE] "
            f"{elapsed:.3f}s"
        )

    def interrupt(self) -> None:

        self.generation_id += 1

        while True:

            try:
                job = self.jobs.get_nowait()

            except queue.Empty:
                break

            if job is not None:
                job.done.set()

            self.jobs.task_done()

        try:

            self.output.stop_stream()
            self.output.close()

            self.output = self.audio.open(
                format=pyaudio.paInt16,
                channels=CHANNELS,
                rate=SAMPLE_RATE,
                output=True,
                frames_per_buffer=2048,
            )

        except Exception as exc:

            print(
                "[TTS AUDIO RESET ERROR] "
                f"{type(exc).__name__}: {exc}"
            )

    def close(self) -> None:

        self.running = False
        self.generation_id += 1

        while True:

            try:
                job = self.jobs.get_nowait()

            except queue.Empty:
                break

            if job is not None:
                job.done.set()

            self.jobs.task_done()

        try:
            self.jobs.put_nowait(None)
        except Exception:
            pass

        try:
            self.worker.join(timeout=3)
        except Exception:
            pass

        try:
            self.output.stop_stream()
            self.output.close()
        except Exception:
            pass

        try:
            self.audio.terminate()
        except Exception:
            pass