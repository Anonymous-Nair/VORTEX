class RealtimeEngine:
    """
    Core real-time orchestration layer.

    This is intentionally independent from the old agent.
    """

    def __init__(self) -> None:
        self.events = EventBus()
        self.llm = LLMEngine()
        self.tts = TTSEngine()

        self.history: list[dict[str, str]] = []

        self._turn_id = 0
        self._interrupt = asyncio.Event()

    async def handle_text(
        self,
        text: str,
    ) -> str:

        self._turn_id += 1
        turn_id = self._turn_id

        # New user turn invalidates previous queued speech.
        self.tts.interrupt()
        self._interrupt.clear()

        await self.events.publish(
            "assistant.thinking",
            turn_id=turn_id,
        )

        messages = [
            {
                "role": "system",
                "content": SYSTEM_PROMPT,
            },
            *self.history[-10:],
            {
                "role": "user",
                "content": text,
            },
        ]

        response = ""
        phrase_buffer = ""

        async for piece, elapsed in self.llm.stream(messages):

            if self._interrupt.is_set():
                break

            response += piece
            phrase_buffer += piece

            await self.events.publish(
                "llm.token",
                text=piece,
                elapsed=elapsed,
                turn_id=turn_id,
            )

            completed, phrase_buffer = self._extract_phrases(
                phrase_buffer
            )

            for phrase in completed:

                # Queue speech asynchronously.
                # _speak() performs the current-turn validation.
                asyncio.create_task(
                    self._speak(
                        phrase,
                        turn_id,
                    )
                )

        if (
            phrase_buffer.strip()
            and not self._interrupt.is_set()
        ):
            asyncio.create_task(
                self._speak(
                    phrase_buffer.strip(),
                    turn_id,
                )
            )

        if response.strip():
            self.history.append(
                {
                    "role": "user",
                    "content": text,
                }
            )

            self.history.append(
                {
                    "role": "assistant",
                    "content": response.strip(),
                }
            )

        await self.events.publish(
            "assistant.completed",
            response=response.strip(),
            turn_id=turn_id,
        )

        return response.strip()

    async def _speak(
        self,
        text: str,
        turn_id: int,
    ) -> None:

        # ----------------------------------------------------
        # STALE TURN GUARD #1
        # ----------------------------------------------------
        if turn_id != self._turn_id:
            return

        # ----------------------------------------------------
        # Ignore fragments containing no speech characters.
        # ----------------------------------------------------
        if not text or not re.search(
            r"[A-Za-z0-9]",
            text,
        ):
            return

        if self._interrupt.is_set():
            return

        try:

            # ------------------------------------------------
            # STALE TURN GUARD #2
            # The user may have started another turn between
            # scheduling this task and reaching this point.
            # ------------------------------------------------
            if turn_id != self._turn_id:
                return

            await self.events.publish(
                "tts.started",
                text=text,
                turn_id=turn_id,
            )

            # TTSEngine owns the actual generation/cancellation
            # generation ID.
            completed = await self.tts.speak(
                text,
            )

            # ------------------------------------------------
            # A False return means this speech was interrupted
            # or invalidated. Do NOT publish tts.completed.
            # ------------------------------------------------
            if not completed:
                return

            # ------------------------------------------------
            # STALE TURN GUARD #3
            # The turn could have changed while TTS was playing.
            # Do not report stale speech as current completion.
            # ------------------------------------------------
            if turn_id != self._turn_id:
                return

            await self.events.publish(
                "tts.completed",
                text=text,
                turn_id=turn_id,
            )

        except Exception as exc:

            await self.events.publish(
                "tts.error",
                error=str(exc),
                turn_id=turn_id,
            )

    def interrupt(self) -> None:
        self._interrupt.set()
        self.tts.interrupt()

        # Notify listeners asynchronously.
        try:
            loop = asyncio.get_running_loop()
            loop.create_task(
                self.events.publish(
                    "assistant.interrupted"
                )
            )
        except RuntimeError:
            pass

    @staticmethod
    def _extract_phrases(
        buffer: str,
    ) -> tuple[list[str], str]:

        phrases: list[str] = []

        while True:

            match = re.search(
                r"(.+?[.!?])(?:\s+|$)",
                buffer,
                flags=re.DOTALL,
            )

            if not match:
                break

            phrase = match.group(1).strip()

            if phrase:
                phrases.append(phrase)

            buffer = buffer[match.end():]

        return phrases, buffer

    async def close(self) -> None:
        self.tts.close()